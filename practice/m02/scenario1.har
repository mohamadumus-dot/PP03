          "content": {
            "size": 5596,
            "mimeType": "text/css",
            "text": "* { box-sizing: border-box; }\r\n\r\nbody {\r\n    margin: 0;\r\n    font-family: \"Segoe UI\", Roboto, Arial, sans-serif;\r\n    font-size: 15px;\r\n    color: #222;\r\n    background: #f5f6f8;\r\n}\r\n\r\na { color: #1f5f8b; }\r\n\r\n.container {\r\n    max-width: 1100px;\r\n    margin: 0 auto;\r\n    padding: 24px 16px 48px;\r\n    min-height: calc(100vh - 120px);\r\n}\r\n\r\n/* ---------- шапка ---------- */\r\n.topbar {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: 16px;\r\n    padding: 12px 24px;\r\n    background: #1f5f8b;\r\n    color: #fff;\r\n    flex-wrap: wrap;\r\n}\r\n.topbar a { color: #fff; text-decoration: none; }\r\n.topbar nav { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }\r\n.logo { font-weight: 700; font-size: 18px; }\r\n.user-name { opacity: .8; font-size: 14px; }\r\n\r\n.footer {\r\n    text-align: center;\r\n    padding: 16px;\r\n    color: #888;\r\n    font-size: 13px;\r\n}\r\n\r\n/* ---------- кнопки и формы ---------- */\r\n.btn {\r\n    display: inline-block;\r\n    padding: 8px 16px;\r\n    border: 0;\r\n    border-radius: 6px;\r\n    background: #2e7bb5;\r\n    color: #fff !important;\r\n    cursor: pointer;\r\n    font-size: 14px;\r\n    text-decoration: none;\r\n}\r\n.btn:hover { background: #24689b; }\r\n.btn:disabled { opacity: .5; cursor: default; }\r\n.btn-light { background: #e8eef3; color: #1f5f8b !important; }\r\n.btn-light:hover { background: #d8e3ec; }\r\n.btn-small { padding: 4px 10px; font-size: 13px; }\r\n.btn-wide { width: 100%; }\r\n\r\ninput, select, textarea {\r\n    padding: 8px 10px;\r\n    border: 1px solid #ccd3da;\r\n    border-radius: 6px;\r\n    font: inherit;\r\n    background: #fff;\r\n}\r\nlabel { display: block; margin-bottom: 12px; font-size: 14px; color: #444; }\r\nlabel input, label select, label textarea { display: block; width: 100%; margin-top: 4px; }\r\n.field-error { color: #c0392b; font-size: 13px; }\r\n\r\n.search { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }\r\n.search input { flex: 1; min-width: 220px; }\r\n\r\n.inline-form { display: flex; gap: 8px; flex-wrap: wrap; }\r\n.inline-form input { flex: 1; min-width: 200px; }\r\n\r\n.form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 16px; }\r\n.span-2 { grid-column: span 2; }\r\n\r\n.auth-box {\r\n    max-width: 420px;\r\n    margin: 40px auto;\r\n    background: #fff;\r\n    padding: 24px 28px;\r\n    border-radius: 10px;\r\n    box-shadow: 0 2px 8px rgba(0, 0, 0, .06);\r\n}\r\n\r\n/* ---------- сообщения ---------- */\r\n.alert { padding: 10px 14px; border-radius: 6px; margin: 12px 0; }\r\n.alert-success { background: #e6f4ea; color: #1e6b34; }\r\n.alert-error { background: #fdecea; color: #a12b1f; }\r\n.muted { color: #888; font-size: 13px; }\r\n\r\n/* ---------- каталог ---------- */\r\n.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }\r\n.book-card {\r\n    display: flex;\r\n    gap: 12px;\r\n    padding: 12px;\r\n    background: #fff;\r\n    border-radius: 10px;\r\n    text-decoration: none;\r\n    color: inherit;\r\n    box-shadow: 0 1px 4px rgba(0, 0, 0, .06);\r\n    transition: box-shadow .15s;\r\n}\r\n.book-card:hover { box-shadow: 0 4px 14px rgba(0, 0, 0, .1); }\r\n.book-card img, .book-card .cover-placeholder { width: 64px; height: 90px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }\r\n.book-title { font-weight: 600; margin-bottom: 4px; }\r\n.cover-placeholder {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    background: #dfe8ef;\r\n    color: #1f5f8b;\r\n    font-size: 28px;\r\n    font-weight: 700;\r\n}\r\n.badge { display: inline-block; margin-top: 6px; padding: 2px 8px; border-radius: 10px; font-size: 12px; }\r\n.badge-ok { background: #e6f4ea; color: #1e6b34; }\r\n.badge-no { background: #f3e9e9; color: #8a2b2b; }\r\n.pager { display: flex; gap: 6px; margin-top: 20px; justify-content: center; }\r\n\r\n/* ---------- страница книги ---------- */\r\n.book-page { display: flex; gap: 32px; background: #fff; padding: 24px; border-radius: 10px; }\r\n.book-cover img, .book-cover .cover-placeholder { width: 180px; height: 260px; object-fit: cover; border-radius: 6px; font-size: 64px; }\r\n.book-info h1 { margin-top: 0; }\r\n.author { font-size: 18px; color: #555; }\r\n.props th { text-align: left; padding: 4px 16px 4px 0; color: #777; font-weight: normal; }\r\n\r\n.reviews { margin-top: 24px; }\r\n.review { background: #fff; padding: 12px 16px; border-radius: 8px; margin-bottom: 10px; }\r\n.review-head { display: flex; gap: 12px; align-items: baseline; margin-bottom: 6px; }\r\n.stars { color: #e0a100; letter-spacing: 1px; }\r\n.review-form { background: #fff; padding: 16px; border-radius: 8px; margin-bottom: 16px; }\r\n.review-form textarea { width: 100%; margin: 8px 0; }\r\n\r\n/* ---------- таблицы ---------- */\r\n.table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden; }\r\n.table th, .table td { padding: 8px 12px; border-bottom: 1px solid #eef0f2; text-align: left; vertical-align: top; }\r\n.table th { background: #f0f3f6; font-weight: 600; font-size: 13px; color: #555; }\r\n.row-late td { background: #fff4f2; }\r\n\r\n.card { background: #fff; padding: 16px 20px; border-radius: 10px; margin-bottom: 20px; }\r\n.stats { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }\r\n.stats div { background: #fff; padding: 14px 20px; border-radius: 10px; min-width: 140px; }\r\n.stats b { display: block; font-size: 26px; color: #1f5f8b; }\r\n.stats span { color: #888; font-size: 13px; }\r\n\r\n@media (max-width: 700px) {\r\n    .book-page { flex-direction: column; }\r\n    .form-grid { grid-template-columns: 1fr; }\r\n    .span-2 { grid-column: auto; }\r\n}\r\n"
